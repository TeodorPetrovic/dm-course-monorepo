# Primer promenljivih okruženja. Kopiraj u .env (koji je u .gitignore) ili ih export-uj u shell.
# Ništa ovde nije pravi ključ ni prava baza.

# --- AI provider (Day 11) ---
# demo/auto = besplatno, deterministički (template / scripted double). deepseek = PRAVI LLM, PLAĆA SE po pozivu.
AI_PROVIDER=auto
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# Bilo koji OpenAI-kompatibilan API (AI_PROVIDER=external):
# AI_EXTERNAL_BASE_URL=https://api.example.com/v1
# AI_EXTERNAL_API_KEY=your-api-key-here
# AI_EXTERNAL_MODEL=gpt-4o-mini

# --- dm-ml API (opciono) ---
# DM_MODELS_DIR=/tmp/dm-models        # gde se čuvaju trenirani modeli (podrazumevano apps/api/app/models)
# DM_LIVE_EVENTS=/tmp/live_events.csv # gde idu događaji primljeni preko API-ja
# DM_COURSE_ROOT=./course             # folder sa "Day N/" (podrazumevano se pronalazi sam)

# --- Frontend -> lokalna MariaDB (db/start_local_db.sh) ---
# Ovo su LAŽNI lokalni demo kredencijali koje kreira db/start_local_db.sh (samo 127.0.0.1).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=dm_local
DB_PASSWORD=dm_local
DB_NAME=dm_local
ML_API_URL=http://127.0.0.1:3001
